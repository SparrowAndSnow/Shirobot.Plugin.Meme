<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.0.1</Version>
        <ShiroBotSdkVersion Condition="'$(ShiroBotSdkVersion)' == ''">1.0.3</ShiroBotSdkVersion>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <Configurations>Debug;Release</Configurations>
        <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' == 'Release'">true</ShiroBotPluginPackagingEnabled>
        <ShiroBotPluginPackagingEnabled Condition="'$(Configuration)' != 'Release'">false</ShiroBotPluginPackagingEnabled>
        <DebugType>portable</DebugType>
        <ShiroBotPluginSharedAssemblies>ShiroBot.Model.QQ;ShiroBot.Model.Discord;ShiroBot.Model.Telegram</ShiroBotPluginSharedAssemblies>
        <ShiroBotDevelopmentHostEnabled>false</ShiroBotDevelopmentHostEnabled>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Tests/**/*.cs;dev/**/*.cs;scripts/**/*.cs" />
        <InternalsVisibleTo Include="ShiroBot.MemePlugin.Verification" />
        <PackageReference Include="ShiroBot.SDK" Version="$(ShiroBotSdkVersion)" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
    </ItemGroup>

</Project>
